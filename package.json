{
  "name": "nft-studio",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint app components lib hooks vite.config.ts next.config.ts",
    "format": "oxfmt",
    "verify:mint": "node scripts/verify-mint.mjs",
    "verify:design": "node scripts/verify-design.mjs",
    "verify:campaign": "node scripts/verify-campaign.mjs",
    "verify:interactive": "node scripts/verify-interactive.mjs",
    "verify:kayfabe": "node scripts/verify-kayfabe.mjs",
    "verify:games": "node scripts/verify-arcade.mjs",
    "build:beats": "node scripts/build-beat-lab.mjs",
    "build:abcde": "PRISM_BASE_PATH=/ABCDE/BMKR vinext build && node scripts/export-abcde.mjs",
    "build:pages": "NFT_STUDIO_BASE_PATH=/NFT-Studio vinext build && node scripts/export-studio.mjs",
    "verify:studio": "node scripts/verify-studio.mjs",
    "typecheck": "tsc --noEmit",
    "verify:labs": "node scripts/verify-labs.mjs && node scripts/verify-proof-of-existence.mjs",
    "verify:knowledge": "node knowledge/verify.mjs && node knowledge/verify-cip-drift.mjs && node knowledge/verify-implementations.mjs --require-repository && node knowledge/standards/scripts/build-bundle.mjs --check && python3 -B knowledge/standards/scripts/build.py --check && python3 -B knowledge/standards/test/extraction.py && python3 -B knowledge/standards/test/retrieval-redirect.py && node --test knowledge/standards/test/corpus.test.mjs",
    "verify:capsules": "node contracts/state-capsule/scripts/verify-codec.mjs && node contracts/state-capsule/scripts/verify-transactions.mjs && node contracts/state-capsule/scripts/build-demo.mjs --check",
    "verify:mcp": "npm --prefix mcp test",
    "verify:passport": "node scripts/verify-artifact-passport.mjs && node scripts/build-passport-demo.mjs --check",
    "verify:holder": "npm --prefix experiments/holder-proof test",
    "verify:music": "node scripts/verify-music-release.mjs && node scripts/verify-music-transactions.mjs && node scripts/verify-music-receipts.mjs",
    "verify:parameters": "npm --prefix experiments/capsule-parameterizer test",
    "verify:registry": "npm --prefix experiments/cip26-inspector test"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@emurgo/cardano-serialization-lib-browser-inlined": "17.0.0",
    "@harmoniclabs/cbor": "2.0.2",
    "@harmoniclabs/plutus-data": "2.0.1",
    "@harmoniclabs/uplc": "2.0.7",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "fflate": "^0.8.3",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/workers-types": "5.20260903.1",
    "@emurgo/cardano-serialization-lib-nodejs": "17.0.0",
    "@napi-rs/canvas": "0.1.80",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "esbuild": "0.28.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.0"
  },
  "type": "module"
}
